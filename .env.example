# ---------------------------------------------------------------------------
# Model Vault — environment configuration
#
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# `.env*` files are git-ignored; only this example is committed.
#
# NEVER commit real credentials. On Vercel, set these in the project's
# Environment Variables settings instead of a file.
# ---------------------------------------------------------------------------

# Postgres connection string. REQUIRED — the app refuses to start without it.
# This is the metadata database (users, sessions, file records, upload
# reservations). Any Postgres works: local, Neon, Supabase, RDS, ...
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# S3-compatible object storage (Backblaze B2) for model binaries + thumbnails.
# REQUIRED.
#
# The bucket itself stays PRIVATE — the app streams bytes through its
# authenticated API and mints short-lived presigned URLs for browser uploads.
# See README "Setting up Backblaze B2" for the dashboard steps.
# ---------------------------------------------------------------------------

# S3 credentials: a Backblaze B2 application key (App Keys → Add a New
# Application Key), scoped to the bucket below with read/write capability.
# The keyID goes into R2_ACCESS_KEY_ID, the applicationKey into
# R2_SECRET_ACCESS_KEY. (Any S3-compatible provider works — these are the
# standard AWS-style names.)
R2_ACCESS_KEY_ID=your-application-key-id
R2_SECRET_ACCESS_KEY=your-application-key

# The bucket name. Create it as a private bucket; do NOT enable public access.
R2_BUCKET_NAME=model-vault

# REQUIRED: the provider's actual S3-compatible endpoint (no bucket name in
# it). For Backblaze B2, copy it from the bucket page — e.g.:
#   R2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# For local development point it at an S3-compatible server such as MinIO:
#   R2_ENDPOINT=http://127.0.0.1:9000
R2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Per-file upload limit in megabytes (default: 300).
# NOTE: the single-request multipart endpoint (POST /api/files) additionally
# cannot exceed the serverless platform's request-body cap (a few MB on
# Vercel). The browser UI always uses the presigned direct-to-bucket flow, so UI
# uploads work up to MAX_UPLOAD_MB regardless.
# MAX_UPLOAD_MB=300

# Total workspace storage cap in bytes (default: unset = unlimited).
# When set, the server rejects any upload that would push the shared library
# over this limit (413), and the sidebar usage meter shows the ratio.
# Accounting comes from Postgres metadata, so it holds on serverless.
# LIBRARY_QUOTA_BYTES=10737418240

# How long a presigned upload reservation stays valid, in minutes
# (default: 30). Abandoned reservations expire and their bytes are cleaned up.
# PENDING_UPLOAD_TTL_MINUTES=30

# How long a login stays valid, in days (default: 30).
# SESSION_TTL_DAYS=30

# Brute-force protection for POST /api/auth/login (defaults shown).
# Failed attempts are counted per (IP + username) and per IP; a successful
# login clears the counter. Counters live in server memory only.
# LOGIN_RATE_WINDOW_MINUTES=15
# LOGIN_MAX_FAILURES_PER_ACCOUNT=8
# LOGIN_MAX_FAILURES_PER_IP=40
# LOGIN_LOCKOUT_MINUTES=10

# Set to "true" when the app runs behind a trusted reverse proxy that sets
# X-Forwarded-For (used for rate-limit keys and logging only). On Vercel the
# platform sets this header itself, so TRUST_PROXY=true is recommended there.
# TRUST_PROXY=false

# Optional. The public origin users reach the app on, e.g.
# https://vault.example.com — only used as an extra allowed origin for the
# CSRF check (Host + X-Forwarded-Host are checked automatically).
# PUBLIC_ORIGIN=

# Sessions are opaque 256-bit random tokens stored in Postgres, so there is
# deliberately NO session signing secret to configure — nothing to rotate or
# leak, and revocation is instant because the server owns the session table.
